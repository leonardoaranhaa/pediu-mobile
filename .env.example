# Copie para .env no servidor. Não coloque estes valores no aplicativo do celular,
# exceto os que começam com EXPO_PUBLIC_.

NODE_ENV=production
PORT=3000

# Cole a URI do Supabase. Pode ser a conexão direta ou o pooler (porta 6543).
# O servidor liga SSL sozinho fora do seu computador e desliga prepared statements no pooler.
# DIRECT_URL é opcional: use a conexão direta só se a migration falhar no pooler.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require
# DIRECT_URL=postgresql://usuario:senha@db.seu-projeto.supabase.co:5432/postgres?sslmode=require

JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ALLOWED_ORIGINS=https://seu-servico.onrender.com
OBSERVABILITY_TOKEN=troque-por-um-token-aleatorio

# E-mails que viram administrador ao criar a conta no aplicativo.
# Separe por vírgula. O primeiro admin é a pessoa que se cadastra com um destes e-mails.
ADMIN_EMAILS=dono@example.com

# Só no celular / EAS. Não coloque senha, JWT_SECRET nem DATABASE_URL aqui.
EXPO_PUBLIC_API_BASE_URL=https://seu-servico.onrender.com

# PIX, quando for usar dinheiro de verdade. Deixe manual no primeiro teste com dinheiro na entrega.
PIX_PROVIDER=manual
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=

# Opcional e desligado no piloto. Sem estas variáveis não há imagem de anúncio gerada,
# arquivo enviado, transcrição de voz nem aviso pelo serviço antigo da Manus.
# Pedido, login e aviso pelo aplicativo da Expo continuam funcionando.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
EMAIL_VERIFICATION_BASE_URL=
COOKIE_DOMAIN=
