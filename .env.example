# Copie para .env no servidor. Não coloque estes valores no aplicativo do celular,
# exceto os que começam com EXPO_PUBLIC_.

NODE_ENV=production
PORT=3000

# MySQL de hoje. Uma URL postgres:// do Supabase ainda não funciona neste código.
# Veja docs/HOSPEDAGEM.md
DATABASE_URL=mysql://usuario:senha@host:3306/pediu

VITE_APP_ID=pediu-pilot
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ALLOWED_ORIGINS=https://seu-dominio-web.example.com
OBSERVABILITY_TOKEN=troque-por-um-token-aleatorio

OAUTH_SERVER_URL=https://seu-provedor-oauth.example.com
OWNER_OPEN_ID=open-id-da-conta-administradora

# Só no celular / EAS, nunca segredos.
EXPO_PUBLIC_API_BASE_URL=https://api.seudominio.com
EXPO_PUBLIC_APP_ID=pediu-pilot
EXPO_PUBLIC_OAUTH_PORTAL_URL=https://seu-provedor-oauth.example.com
EXPO_PUBLIC_OAUTH_SERVER_URL=https://seu-provedor-oauth.example.com

# PIX, quando for usar dinheiro de verdade. Deixe vazio no primeiro teste com dinheiro na entrega.
PIX_PROVIDER=manual
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=

# Opcional: avisos, e-mail e serviços internos.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
EMAIL_VERIFICATION_BASE_URL=
COOKIE_DOMAIN=
