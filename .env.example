# Copie para .env e ajuste. Valores apenas para desenvolvimento local.
NODE_ENV=development
DATABASE_URL=mysql://pediu:pediu@127.0.0.1:3306/pediu
VITE_APP_ID=pediu-local
JWT_SECRET=troque-este-segredo-local
ALLOWED_ORIGINS=http://localhost:8081

# O Expo web roda em :8081 e a API em :3000.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Login com as contas do seed (pnpm db:seed), sem provedor OAuth.
# O servidor recusa iniciar em produção com esta flag.
# O perfil EAS production não define estas variáveis.
DEV_AUTH_ENABLED=true
EXPO_PUBLIC_DEV_AUTH=true

# Pacote/bundle da loja. O padrão do app é app.pediu.mobile.
# EXPO_PUBLIC_BUNDLE_ID=app.pediu.mobile
# APPLE_BUNDLE_ID=app.pediu.mobile

# PIX fica desligado no checkout até um provedor devolver um código pagável.
# EXPO_PUBLIC_PIX_ENABLED=true
# PIX_CHECKOUT_ENABLED=true

# Contas de revisão de produção. Rode pnpm db:seed:review só no servidor.
# REVIEW_CUSTOMER_OPEN_ID=
# REVIEW_MERCHANT_OPEN_ID=
