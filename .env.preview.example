# Ambiente público do cliente Expo/EAS — nunca coloque segredos aqui.
# Copie os valores reais para o ambiente EAS "preview" ou para .env.preview.local.
EAS_BUILD_PROFILE=preview

# HTTPS público da Render, sem barra no fim. O celular usa só este endereço.
EXPO_PUBLIC_API_BASE_URL=https://seu-servico.onrender.com

# Variáveis privadas do servidor ficam fora deste arquivo:
# DATABASE_URL
# JWT_SECRET
# ALLOWED_ORIGINS
# OBSERVABILITY_TOKEN
# ADMIN_EMAILS
# MERCADO_PAGO_ACCESS_TOKEN
# MERCADO_PAGO_WEBHOOK_SECRET
