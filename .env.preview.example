# Ambiente público do cliente Expo/EAS — nunca coloque segredos aqui.
# Copie os valores reais para o ambiente EAS "preview" ou para .env.preview.local.
EAS_BUILD_PROFILE=preview

# HTTPS público estável, alcançável pelo dispositivo e pelo EAS Build.
EXPO_PUBLIC_API_BASE_URL=https://api-preview.example.com

# Deve coincidir com VITE_APP_ID no backend do mesmo ambiente.
EXPO_PUBLIC_APP_ID=pediu-preview

# OAuth público do aplicativo. Não use tokens ou client secrets nestas variáveis.
EXPO_PUBLIC_OAUTH_PORTAL_URL=https://oauth.example.com
EXPO_PUBLIC_OAUTH_SERVER_URL=https://oauth.example.com

# Identidade pública opcional usada por telas administrativas/contextuais.
EXPO_PUBLIC_OWNER_OPEN_ID=owner-open-id
EXPO_PUBLIC_OWNER_NAME=Pediu

# Variáveis privadas do servidor ficam fora deste arquivo:
# DATABASE_URL
# JWT_SECRET
# VITE_APP_ID
# OAUTH_SERVER_URL
# BUILT_IN_FORGE_API_KEY
# MERCADO_PAGO_ACCESS_TOKEN
# MERCADO_PAGO_WEBHOOK_SECRET
# EMAIL_WEBHOOK_SECRET
